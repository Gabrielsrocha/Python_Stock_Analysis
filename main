#Importando bibliotecas
import pandas as pd
import requests

#Parametros
url = 'http://www.fundamentus.com.br/resultado.php'
header = {
  "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/84.0.4147.89 Safari/537.36"
 }

#Realizando requisição
req = requests.get(url, headers=header)

if req.status_code == 200:
  print("Processando requisição ao Fundamentus")
else:
  print("Ocorreu um erro ao processar a requisição:", {req.status_code})

df = pd.read_html(req.text,  decimal=',', thousands='.')[0]
#Tratamento dos dados
def tratamento_dados(df):
  for coluna in ['Div.Yield', 'Mrg. Líq.', 'P/L', 'ROE', 'Cresc. Rec.5a','EV/EBIT']:
    df[coluna] = df[coluna].apply(str).str.replace('.','')
    df[coluna] = df[coluna].apply(str).str.replace(',','.')
    df[coluna] = df[coluna].apply(str).str.rstrip('%').astype('float') / 100
  return df

df = tratamento_dados(df)
#Filtros
def filtros(df):
  df = df[df['Liq.2meses'] > 100000]
  df = df[df['Dív.Brut/ Patrim.'] < 1]
  df = df[df['P/L'] > 0]
  df = df[df['Mrg. Líq.'] > 0.1]
  df = df[df['P/L'] <= 25]
  df = df[df['Cresc. Rec.5a'] > 0.1]
  return df

df = filtros(df)
#Rankeamento
ranking = pd.DataFrame()
ranking = df[['Papel','Div.Yield', 'Mrg. Líq.', 'P/L', 'ROE', 'Cresc. Rec.5a','EV/EBIT']]
ranking['Div.Yield rank'] = ranking['Div.Yield'].rank(method='max')
ranking['Mrg. Líq. rank'] = ranking['Mrg. Líq.'].rank(method='max')
ranking['P/L rank'] = ranking['P/L'].rank(method='max',ascending=False)
ranking['ROE rank'] = ranking['ROE'].rank(method='max')
ranking['Cresc. Rec.5a rank'] = ranking['Cresc. Rec.5a'].rank(method='max')
ranking['EV/EBIT rank'] = ranking['EV/EBIT'].rank(method='max',ascending=False)


#Somatório do Ranking
sranking = ranking[['Papel','Div.Yield rank','Mrg. Líq. rank','P/L rank','ROE rank','Cresc. Rec.5a rank','EV/EBIT rank']]
sranking['Total'] = sranking['Div.Yield rank']+sranking['Mrg. Líq. rank']+sranking['P/L rank']*1.3+sranking['ROE rank']*1.4+sranking['Cresc. Rec.5a rank']*1.2+sranking['EV/EBIT rank']
sranking = sranking.sort_values(by='Total', ascending=False)
print('Factor Investing')
print('Isso não é uma recomendação de compra, é preciso avaliar cada papel e setor')
print("Ranking")
sranking.head(200)